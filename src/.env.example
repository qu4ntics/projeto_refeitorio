# Copie para .env e preencha. Nenhuma linha aqui deve conter valores reais.

# --- Núcleo ---
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=True

# Hosts e origens confiáveis (separados por vírgula). Em produção, sem '*'.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://exemplo.onrender.com

# --- Banco (PostgreSQL) ---
DB_NAME=reservaif
DB_USER=postgres
DB_PASSWORD=senha
DB_HOST=localhost
DB_PORT=5432

# --- E-mail ---
# Dev: console (o código de confirmação aparece no terminal do runserver).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=IFome <no-reply@exemplo.edu.br>
# Para envio real, troque o backend acima por
# django.core.mail.backends.smtp.EmailBackend e preencha:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# --- Regras de cadastro ---
# Domínios institucionais aceitos no cadastro de aluno (vírgula). Vazio = sem restrição.
ALUNO_EMAIL_DOMINIOS=
